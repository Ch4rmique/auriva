        <?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.ScrollPane?>
        <?import javafx.scene.control.TableColumn?>
        <?import javafx.scene.control.TableView?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.AnchorPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F1F5F9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vehiclerental.controller.CustomerController">
<children>

    <!-- SIDEBAR -->
    <VBox prefHeight="800.0" prefWidth="220.0" style="-fx-background-color: #1E40AF; -fx-spacing: 0; -fx-padding: 0;">
        <children>
            <VBox style="-fx-alignment: center; -fx-padding: 30px 20px 20px 20px; -fx-spacing: 8;">
                <children>
                    <Label style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold; -fx-background-color: #2563EB; -fx-background-radius: 12px; -fx-padding: 8px 16px;" text="A" />
                    <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="AURIVA" />
                    <Label style="-fx-text-fill: #93C5FD; -fx-font-size: 11px;" text="Vehicle Rentals" />
                </children>
            </VBox>
            <Label prefHeight="1.0" prefWidth="220.0" style="-fx-background-color: #1D4ED8;" />
            <Label prefHeight="10.0" />
            <Button fx:id="dashboardBtn" mnemonicParsing="false" onAction="#handleDashboard" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-text-fill: #BFDBFE; -fx-font-size: 14px; -fx-alignment: center-left; -fx-padding: 0 0 0 24px; -fx-cursor: hand;" text="  Dashboard" />
            <Button fx:id="vehiclesBtn" mnemonicParsing="false" onAction="#handleVehicles" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-text-fill: #BFDBFE; -fx-font-size: 14px; -fx-alignment: center-left; -fx-padding: 0 0 0 24px; -fx-cursor: hand;" text="  Vehicles" />
            <Button fx:id="customersBtn" mnemonicParsing="false" onAction="#handleCustomers" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-alignment: center-left; -fx-padding: 0 0 0 24px; -fx-cursor: hand; -fx-border-width: 0 0 0 4px; -fx-border-color: #D4AF37;" text="  Customers" />
            <Button fx:id="rentalsBtn" mnemonicParsing="false" onAction="#handleRentals" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-text-fill: #BFDBFE; -fx-font-size: 14px; -fx-alignment: center-left; -fx-padding: 0 0 0 24px; -fx-cursor: hand;" text="  Rentals" />
            <Button fx:id="usersBtn" mnemonicParsing="false" onAction="#handleUsers" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-text-fill: #BFDBFE; -fx-font-size: 14px; -fx-alignment: center-left; -fx-padding: 0 0 0 24px; -fx-cursor: hand;" text="  Users" />
            <Button fx:id="aboutBtn" mnemonicParsing="false" onAction="#handleAbout" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-text-fill: #BFDBFE; -fx-font-size: 14px; -fx-alignment: center-left; -fx-padding: 0 0 0 24px; -fx-cursor: hand;" text="  About" />
            <Label prefHeight="200.0" />
            <Label prefHeight="1.0" prefWidth="220.0" style="-fx-background-color: #1D4ED8;" />
            <VBox style="-fx-padding: 16px 20px; -fx-spacing: 4;">
                <children>
                    <Label fx:id="loggedInName" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" text="Administrator" />
                    <Label fx:id="loggedInRole" style="-fx-text-fill: #93C5FD; -fx-font-size: 11px;" text="Admin" />
                </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#handleLogout" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: #1D4ED8; -fx-text-fill: #FCA5A5; -fx-font-size: 14px; -fx-alignment: center-left; -fx-padding: 0 0 0 24px; -fx-cursor: hand;" text="  Logout" />
        </children>
    </VBox>

    <!-- MAIN CONTENT -->
    <VBox layoutX="220.0" prefHeight="700.0" prefWidth="880.0" style="-fx-background-color: #F1F5F9; -fx-spacing: 0;">
        <children>

            <!-- TOP BAR -->
            <HBox prefHeight="70.0" prefWidth="880.0" style="-fx-background-color: #FFFFFF; -fx-alignment: center-left; -fx-padding: 0 30px; -fx-spacing: 20;">
                <children>
                    <VBox style="-fx-spacing: 2;">
                        <children>
                            <Label style="-fx-text-fill: #0F172A; -fx-font-size: 20px; -fx-font-weight: bold;" text="Customer Directory" />
                            <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" text="Manage client profiles and rental eligibility" />
                        </children>
                    </VBox>
                    <Label style="-fx-pref-width: 320;" />
                    <Button mnemonicParsing="false" onAction="#handleAddCustomer" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 20px; -fx-cursor: hand;" text="Add Customer" />
                </children>
            </HBox>

            <!-- SEARCH AND CONTROL BAR -->
            <HBox style="-fx-background-color: #FFFFFF; -fx-padding: 15px 30px; -fx-spacing: 12; -fx-alignment: center-left; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1px 0;">
                <children>
                    <TextField fx:id="searchField" prefHeight="38.0" prefWidth="300.0" promptText="Search by customer name..." style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-width: 1.5px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-size: 13px; -fx-padding: 0 12px;" />
                    <Button mnemonicParsing="false" onAction="#handleSearch" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8px; -fx-padding: 10px 16px; -fx-cursor: hand;" text="Search" />
                    <Button mnemonicParsing="false" onAction="#handleClear" style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-background-radius: 8px; -fx-padding: 10px 16px; -fx-cursor: hand;" text="Clear" />
                    <Label style="-fx-pref-width: 120;" />
                    <Button mnemonicParsing="false" onAction="#handleEditCustomer" style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 16px; -fx-cursor: hand;" text="Edit" />
                    <Button mnemonicParsing="false" onAction="#handleDeleteCustomer" style="-fx-background-color: #FEF2F2; -fx-text-fill: #EF4444; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 16px; -fx-cursor: hand;" text="Delete" />
                </children>
            </HBox>

            <!-- CUSTOMER LIST CONTAINER -->
            <VBox style="-fx-padding: 24px; -fx-spacing: 12;">
                <children>

                    <HBox style="-fx-alignment: center-left;">
                        <children>
                            <Label text="All Customers"
                                   style="-fx-text-fill: #0F172A;
                              -fx-font-size: 14px;
                              -fx-font-weight: bold;" />
                            <Label style="-fx-pref-width: 600;" />
                            <Label fx:id="customerCountLabel"
                                   text="0 customers"
                                   style="-fx-text-fill: #94A3B8;
                              -fx-font-size: 12px;" />
                        </children>
                    </HBox>

                    <TableView fx:id="customersTable" prefHeight="500.0" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px;">
                        <columns>
                            <TableColumn fx:id="customerNameCol" prefWidth="220.0" text="Customer Name" />
                            <TableColumn fx:id="customerPhoneCol" prefWidth="180.0" text="Phone Number" />
                            <TableColumn fx:id="customerEmailCol" prefWidth="220.0" text="Email Address" />
                            <TableColumn fx:id="customerLicenseCol" prefWidth="180.0" text="Driving License Number" />
                        </columns>
                    </TableView>

                </children>
            </VBox>
        </children>
    </VBox>

</children>
</AnchorPane>




















